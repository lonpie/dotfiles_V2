# fuzzy navigation 
function cdf()
{
    while true; do
        #echo -e "\e[?25l"
        printf "\e[?25l"
        selection=$(ls -a | fzf --height=50% \
            --reverse \
            --multi \
            --cycle \
            --info=inline \
            --bind 'alt-k:preview-up' \
            --bind 'alt-j:preview-down' \
            --bind 'alt-enter:preview-down' \
            --prompt "$(pwd) " \
            --border "rounded" \
            --preview-window=right:70%,border:"rounded" \
            --preview='prev_dir=$(pwd)/{} ; echo -e "\e[01;91m >>> $prev_dir \e[0m" ;  if [ -d {} ] ; then  ls --color=always -a $prev_dir ; else less $prev_dir ; fi')

        if [  "$selection" == "" ]
        then
            break;
        fi
        if [ -d $selection ]
        then
            if [[ "$selection" == "." ]]
            then
                break
            else
                cd "$selection"
            fi
        else
            vim "$selection"
        fi
    done
    #echo -e "\e[?25h"
    printf "\e[?25h"
}

function cdfy()
{
    while true; do
        printf "\e[?25l"
        selection=$(ls -a | fzy \
            --prompt="$(echo -e "\e[01;94m" $(pwd) "\e[0m")" \
        )
        if [ "$selection" == "" ]
        then
            break
        fi
        if [ -d "$selection" ]
        then
            cd "$selection"
            if [ "$selection" == "." ]
            then
                break 
            fi
        else
            vim "$selection"
        fi
    done
    printf "\e[?25h"
}

