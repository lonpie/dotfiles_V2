function print_git_info()
{
    STR=""
    #getting the repository name and if it has a remote or not
    REPOS=$(git remote get-url origin 2> /dev/null)
    RET=$?


    if [ $RET -eq 128 ] ; then    # not a repo
        return $RET         # quit
    elif [ $RET -eq 0 ]; then  #repos distant ok 
        REPOS=${REPOS##*/}; REPOS=${REPOS%%.*}
        STR="$STR\033[01;96m[$REPOS]\033[0m" # affiche repos en vert
    elif [ $RET -eq 2 ]; then #pas de repos distant  
        STR="$STR\033[01;91m[local]\033[0m" # affiche 'local' en rouge
    fi


    MODIF=""
    if [ -n "$(git status -s 2> /dev/null)" ]; then
        MODIF='*'
    fi

    BRANCH_FULL="$(git branch -vv 2> /dev/null| grep \* | sed 's/\*//')"    # recupére les infos surr la branche courante
    BRANCH=$(echo "$BRANCH_FULL" | cut --delimiter=' ' -f2) # extrait le nom de la branch courante
    if [ -z "$(echo $BRANCH_FULL | grep "origin")" ]; then # pas de branch distante
        STR="$STR \033[01;91m[$BRANCH$MODIF]\033[0m"           #affiche branch en rouge
    else
        if [ -n "$(echo $BRANCH_FULL | grep avance)" ]; then # branch local en avance
            STR="$STR \033[01;93m[$BRANCH$MODIF]\033[0m"  # affiche branch en jaune
        else
            STR="$STR \033[01;92m[$BRANCH$MODIF]\033[0m"  # affiche branch en vert
        fi
    fi 

    echo -e $STR
}

