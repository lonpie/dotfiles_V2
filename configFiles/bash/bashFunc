# Ce script permet de remplacer les suppression par des déplacement dans une corbeille définie par l'utilisateur grâce la variable d'environnement $TRASH_RM_SAFE.
# Si aucune variable $TRASH_RM_SAFE n'est définie, le répertoire '~/.trash' est utilisé comme corbeille.
# Le moyen le plus simple d'utiliser ce script est de définir un alias remplaçant /bin/rm par rm_safe
function rm_safe ()
{
    trash_config_file="/home/pierre/.local/share/rm_safe/trash_rm_safe"
    # On peut configurer une corbeille personnalisé en indiquant sont emplacement dans le fichier
    # $trash_config_file
    if [ -f "$trash_config_file" ] # si l'utilisateur a configurer le fichier definissant trash
    then
        #echo trash already configured, $TRASH_RM_SAFE
        TRASH_RM_SAFE=$(cat $trash_config_file)
    else    # si l'utilisateur n'a pas configuré le fichier $trash_config_file
        TRASH_RM_SAFE=~/.trash  # on utilise la corbeille par default
        #echo trash not configured, use ~/.trash
    fi

    if [ ! -d "$TRASH_RM_SAFE" ] #si le repertoire $TRASH_RM_SAFE configuré dans le fichier $trash_config_file n'existe pas
    then
        #echo trash directory don\'t exist, create a new one
        mkdir -p "$TRASH_RM_SAFE"
    fi

    if [ $# -eq 0 ]
    then
        echo -e "Bad usage..."
        echo -e "rm [FILES]\t\tMove file to $TRASH_RM_SAFE"
        echo -e "rm -p, --purge\t\tMove file in $TRASH_RM_SAFE to /tmp/rm_trash/"
        return
    else
        if [ $# -eq 1 ]
        then
            if [ "$1" == "--purge" ] || [ "$1" == "-p" ]
            then
                echo "Voulez vous vider $TRASH_RM_SAFE ?"
                echo "(Y/n)"
                read READ
                if [[ "$READ" == "Y" ]]
                then
                    if [ "$(ls -A $TRASH_RM_SAFE)" ]; then
                        TMP_RM_DIR=/tmp/rm_trash
                        if [[ ! -d "$TMP_RM_DIR" ]]; then
                            mkdir $TMP_RM_DIR
                        fi
                        mv -f --suffix=$(date "+%H_%M_%S_%m%d%y") $TRASH_RM_SAFE/* $TRASH_RM_SAFE/.* /tmp/rm_trash 2> /dev/null
                        echo "$TRASH_RM_SAFE cleaned."
                    else
                        echo $TRASH_RM_SAFE is empty


                    fi
                else
                    echo "Avoid."
                fi
                return
            fi
        fi
    fi

    for f in $*
    do
        if [[ -z "$(echo -n $f | grep -E "^-")" ]]
        then
            if [[ -a "$f" || -L "$f" ]]; then
                NEWFILENAME=$(basename $f)\_$(date "+%d%m%y_%H_%M_%S")
                NEWDIRNAME=$TRASH_RM_SAFE$(dirname $(readlink -f $f))
                #echo $NEWDIRNAME
                #echo $NEWFILENAME
                mkdir -p $NEWDIRNAME
                mv -f  $f $NEWDIRNAME/$NEWFILENAME
                find $NEWDIRNAME/$NEWFILENAME -exec touch {} +
            else
                echo "error : file not found"
            fi
            #else
            #echo "error file name begining by '-'" 
        fi
    done
}
