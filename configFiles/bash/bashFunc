# Ce script permet de formater un fichier markdown afin de pouvoir le lire avec mdp
# mdp utilise des séparateurs du type '\n------\n' afin de séparer chaque slide
# ce script ajoute ce séparateur de maniére réguliére tout au long du fichier markdown afin de pouvoir le lire avec mdp sans débordement
function fmdp()
{
    # test le nombre de paramétres
    if [ $# -ne 1 ]; 
    then
        echo argument invalide : nombre d\'argument invalide.
        return -1
    fi
    # test si le fichier existe
    if [ ! -f $1 ];
    then
        echo argument invalide : fichier introuvable.
        return -1
    fi
    mdFile=$1
    nbLine=$(wc -l $mdFile | cut -f1 -d\ ) # extrait le nombre de ligne du fichier
    # divide by one to round to lower integer
    maxLine=$(echo $LINES*0.7/1 | bc)
    nbSlide=$(expr $nbLine / $maxLine)
    newFileName=/tmp/fmdp/mdp_$1
    # creer le repertoire temporaire
    if [ ! -d /tmp/fmdp ];
    then
        mkdir /tmp/fmdp
    fi
    # si le fichier formaté temporaire existe déja, on le supprime
    if [ -f $newFileName ]; 
    then
        rm $newFileName
    fi
    # on formate le fichier markdown
    for (( i=0; i<=$nbSlide; i++ ))
    do
        d=$(($i * $maxLine + $maxLine))
        head -n$d $mdFile | tail -$maxLine >> $newFileName
        echo -e "\n----\n" >> $newFileName
    done
    mdp --nofade $newFileName
}

