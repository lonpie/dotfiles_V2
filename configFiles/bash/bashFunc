# override de la fonction cd pour sauvegarder les anciens repertoires dans une liste globale
PATH_HIST=($PWD)
IND_PATH_HIST=0
function cd()
{
    max_path_save=20

    # reproduit le fonctionnement par default de cd (sans paramétre, la commande cd vas dans $HOME)
    if [[ $# -eq 0 ]] 
    then
        builtin cd "$HOME"
    else
        builtin cd "$*"
    fi

    # empile le nouveau path 
    PATH_HIST+=($(pwd))
    IND_PATH_HIST=$(($IND_PATH_HIST+1))
    # supprime l'emplacement le plus ancien si plus de N emplacement sont déja sauvegardés (LIFO)
    if [[ ${#PATH_HIST[@]} -gt max_path_save ]]
    then
        IND_PATH_HIST=$(($max_path_save-1))
        PATH_HIST=("${PATH_HIST[@]:1}")
    fi
    #echo "${PATH_HIST[@]}"
    #echo IND_PATH_HIST=$IND_PATH_HIST
    #echo  IND_PATH_SIZE=${#PATH_HIST[@]}
}

