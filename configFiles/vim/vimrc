function Parse_json()
    let s:js_data = readfile('out.json')
    let s:dictData = js_decode(join(s:js_data))

    let s:matches = s:dictData["matches"]

    let s:dictMatches = {}
    let s:nbMatches = 1
    :highlight LT_err_group ctermbg=red guibg=red
    for i in s:matches 
        let s:nbMatches = s:nbMatches + 1
        let l:line = byte2line(i["offset"])
        let l:col =  i["offset"]-line2byte(l:line)+2
        let l:length =  i["length"]
        echo l:line . " " . l:col . " " . l:length
        call matchaddpos("LT_err_group", [[l:line, l:col, l:length]])
