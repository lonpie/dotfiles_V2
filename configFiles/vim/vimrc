"fonction pour executer le code en fonction de l'extension du fichier source
function CodeCompil()
    let actualFileId = win_getid()      "sauvegarde la win actuelle
    let actualBufferId = bufnr('%')     "sauvegarde le buffer actuel
    let fileExtension = expand("%:e")   "extrait l'extension du fichier 
    if fileExtension ==? "py"
        "vert term ./env_pyvis/bin/python3 %
        "vert term ./pyEnvOsm/bin/python3 %
        "TODO remplacer la commande python ci dessus
        exe ":wa"
        compiler pyunit
        set makeprg=python3\ %
        "set makeprg=./env_pyvis/bin/python3\ %
        write
        make
        copen
    elseif fileExtension ==? "c" || fileExtension ==? "h" || fileExtension ==? "cpp"
        compiler gcc
        set makeprg=make
        make
        copen
    elseif fileExtension ==? "asm" || fileExtension ==? "s"
        compiler gcc
        set makeprg=make
        write
        make 
        copen
    elseif fileExtension ==? "plt" || fileExtension ==? "gnuplot"
        "exe ":wa"
        make
        "exe "!gnuplot % > %.pdf" 
        "exe "!gnuplot %" 
        "exe "!atril %.pdf &"
    elseif fileExtension ==? "tex" 
        exe ":wa"
        make
    else
        echo fileExtension." : Extension de fichier non prise en charge..."
    endif 
    "retourne dans la win précédente
    call win_gotoid(actualFileId)   
    "ouvre le buffer précédent
    execute "b".actualBufferId      
endfunc
"fonction pour executer le code
" TODO : fermer l'ancienne window de make exec
function CodeExec()
    let fileExtension = expand("%:e")   "extrait l'extension du fichier 
    if fileExtension ==? "tex"
        echo expand("%:r")
        exec "!make view"
        "exec "!atril out.pdf 2>/dev/null >/dev/null &" 
        "exec "!atril ".expand("%:r").".pdf 2>/dev/null >/dev/null &" 
    elseif fileExtension ==? "md"
        exec "vert term mdp ".expand("%:r").".md"
    elseif fileExtension ==? "c" || fileExtension ==? "h" || fileExtension ==? "cpp"
        let actualFileId = win_getid() "sauvegarde la win actuelle
        execute "term make exec" 
        call win_gotoid(actualFileId) "retourne dans la win precedente"
    else
        echo fileExtension." : Extension de fichier non prise en charge..."
    endif 
endfunc

